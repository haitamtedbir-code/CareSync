{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CareSync : démarrer",
      "type": "process",
      "command": "node",
      "args": [
        "server.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "caresync",
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+)\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^CareSync",
            "endsPattern": "^CareSync disponible : http://localhost:5173"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
